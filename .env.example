# .env 템플릿. 실제 값은 절대 커밋하지 않는다(.env 는 .gitignore 대상).
# 사용: cp .env.example .env 후 각 값을 채운다.

PROFILE_ACTIVE=local
BAND_MANAGER_PORT=8080

# ----- DB -----
# 계정 3분리 (BD-268 침해사고 대응)
#   admin : 슈퍼유저. postgres 컨테이너 부트스트랩/관리 전용. 애플리케이션은 사용하지 않는다.
#   owner : 스키마 소유자. Liquibase 마이그레이션(DDL) 전용
#   app   : 런타임 전용. DML 만 가능하고 DDL 권한 없음
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bandage

DB_ADMIN=
DB_ADMIN_PASSWORD=

DB_USER=
DB_USER_PASSWORD=

DB_OWNER=
DB_OWNER_PASSWORD=

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- JWT -----
JWT_TOKEN_SECRET=

# ----- AWS (S3 + CloudFront) -----
AWS_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CDN_DOMAIN=

# ----- OAuth -----
GOOGLE_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
